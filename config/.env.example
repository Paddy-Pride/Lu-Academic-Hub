# ============================================
# LU Academic Hub - Environment Configuration
# ============================================
# Copy this file to .env and update values
# Do NOT commit .env to version control

# ============================================
# Application Settings
# ============================================
APP_NAME="LU Academic Hub"
APP_TITLE="LIRA University Academic Hub"
APP_URL="http://localhost"
APP_ENV="development"
APP_DEBUG="true"
APP_TIMEZONE="Africa/Kampala"

# ============================================
# Database Configuration
# ============================================
DB_DRIVER="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="lu_academic_hub"
DB_USER="lu_user"
DB_PASS="secure_password_here"
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"

# ============================================
# Email/SMTP Configuration
# ============================================
MAIL_DRIVER="smtp"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_ENCRYPTION="tls"
MAIL_FROM="noreply@lu-academic-hub.com"
MAIL_FROM_NAME="LU Academic Hub"

# ============================================
# Security Settings
# ============================================
SESSION_TIMEOUT="1800"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_HTTPONLY="true"
SESSION_COOKIE_SAMESITE="Lax"
MAX_LOGIN_ATTEMPTS="5"
LOCK_TIMEOUT="900"
CSRF_TOKEN_LENGTH="32"
BCRYPT_COST="10"

# ============================================
# File Upload Settings
# ============================================
FILE_UPLOAD_MAX="52428800"
FILE_UPLOAD_DIR="uploads/"
ALLOWED_EXTENSIONS="pdf,docx,pptx,xlsx,zip,jpg,jpeg,png,gif"
MAX_FILE_SIZE_MB="50"

# ============================================
# Pagination Settings
# ============================================
PAGINATION_LIMIT="20"
PAGINATION_RANGE="5"

# ============================================
# Feature Flags
# ============================================
FEATURE_DARK_MODE="true"
FEATURE_EMAIL_NOTIFICATIONS="true"
FEATURE_SOCIAL_SHARING="true"
FEATURE_ADVANCED_SEARCH="true"
FEATURE_DISCUSSION_FORUM="true"
FEATURE_RESEARCH_REPOSITORY="true"

# ============================================
# Cache Settings
# ============================================
CACHE_DRIVER="file"
CACHE_TTL="3600"

# ============================================
# Logging Settings
# ============================================
LOG_LEVEL="info"
LOG_DIR="logs/"
